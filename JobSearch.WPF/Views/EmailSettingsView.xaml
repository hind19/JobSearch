<UserControl x:Class="JobSearch.WPF.Views.EmailSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             FontSize="13">

    <Border Background="#F2F2F2">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="860"
                        Margin="32,28,32,32">

                <!-- ═══════════════ Header -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="← Назад"
                            Command="{Binding GoHomeCommand}"
                            Style="{StaticResource OutlineButtonStyle}"
                            Padding="10,8"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="Настройки почты"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="SMTP-сервер для отправки дайджеста вакансий"
                                   Foreground="#757575"
                                   FontSize="12"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <!-- ═══════════════ SMTP settings -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Параметры SMTP"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Хост"
                                       Foreground="#757575" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Порт"
                                       Foreground="#757575" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" Margin="0,0,0,10" Width="100" HorizontalAlignment="Left" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Шифрование"
                                       Foreground="#757575" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <CheckBox Grid.Row="2" Grid.Column="1"
                                      IsChecked="{Binding UseSsl}"
                                      Content="Использовать TLS/SSL"
                                      VerticalAlignment="Center" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Логин SMTP"
                                       Foreground="#757575" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding SmtpUsername, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Email отправителя"
                                       Foreground="#757575" VerticalAlignment="Center" Margin="0,0,12,10" />
                            <TextBox Grid.Row="4" Grid.Column="1"
                                     Text="{Binding FromAddress, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" Margin="0,0,0,10" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Отображаемое имя"
                                       Foreground="#757575" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Row="5" Grid.Column="1"
                                     Text="{Binding FromDisplayName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" />
                        </Grid>

                        <TextBlock Text="Логин SMTP — обычно совпадает с Email отправителя, но не всегда (зависит от провайдера). Отображаемое имя — то, что получатель увидит в поле «От кого» вместо email-адреса."
                                   Foreground="#9E9E9E"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />

                        <!-- ── Password note — not editable here, ADR-0005 §2 ── -->
                        <Border BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,10"
                                Margin="0,20,0,0"
                                Background="#FAFAFA">
                            <StackPanel>
                                <TextBlock Text="Пароль SMTP"
                                           FontWeight="SemiBold"
                                           FontSize="13" />
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="#757575"
                                           FontSize="12"
                                           Margin="0,4,0,0"
                                           Text="Пароль не хранится в приложении и не редактируется здесь. Задайте его командой:" />
                                <TextBlock FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="#212121"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="dotnet user-secrets set &quot;EmailSettings:SmtpPassword&quot; &quot;...&quot; --project JobSearch.Worker" />
                            </StackPanel>
                        </Border>

                        <!-- ── Form buttons ── -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,20,0,0">
                            <Button Content="Сохранить"
                                    Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="22,10" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
