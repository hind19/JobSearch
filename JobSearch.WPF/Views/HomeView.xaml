<UserControl x:Class="JobSearch.WPF.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid VerticalAlignment="Center"
          HorizontalAlignment="Center"
          Width="520">
        <StackPanel>

            <TextBlock Text="Что сделаем сегодня?"
                       FontSize="22"
                       FontWeight="Medium"
                       Foreground="#212121"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,6" />

            <TextBlock Text="Выберите раздел для работы"
                       FontSize="14"
                       Foreground="#757575"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,32" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Анализ CV -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Margin="0">
                    <StackPanel>
                        <TextBlock Text="📄"
                                   FontSize="28"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="Анализ CV"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   Foreground="#212121"
                                   Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="#757575"
                                   LineHeight="20"
                                   Text="Загрузите резюме — Claude извлечёт навыки и составит профиль для поиска вакансий"
                                   Margin="0,0,0,20" />
                        <Button Content="Открыть"
                                Command="{Binding OpenProfileCommand}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Padding="0,10" />
                    </StackPanel>
                </Border>

                <!-- Сайты поиска -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}"
                        Margin="0">
                    <StackPanel>
                        <TextBlock Text="🌐"
                                   FontSize="28"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="Сайты поиска"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   Foreground="#212121"
                                   Margin="0,0,0,8" />
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="#757575"
                                   LineHeight="20"
                                   Text="Настройте сайты с вакансиями — Worker будет ежедневно проверять первую страницу результатов"
                                   Margin="0,0,0,20" />
                        <Button Content="Открыть"
                                Command="{Binding OpenJobSitesCommand}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Padding="0,10" />
                    </StackPanel>
                </Border>

            </Grid>
        </StackPanel>
    </Grid>

</UserControl>