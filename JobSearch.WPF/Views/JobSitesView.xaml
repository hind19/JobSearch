<UserControl x:Class="JobSearch.WPF.Views.JobSitesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:JobSearch.WPF.Models"
             xmlns:conv="clr-namespace:JobSearch.WPF.Converters"
             xmlns:views="clr-namespace:JobSearch.WPF.Views"
             FontFamily="Segoe UI"
             FontSize="13">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <!-- Root Grid allows popup to overlay entire content -->
    <Grid>
        <Border Background="#F2F2F2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="860"
                            Margin="32,28,32,32">

                    <!-- ═══════════════ Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="← Назад"
                                Command="{Binding GoHomeCommand}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Padding="10,8"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0" />

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Сайты поиска вакансий"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Только первая страница результатов поиска"
                                       Foreground="#757575"
                                       FontSize="12"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="+ Добавить сайт"
                                Command="{Binding AddSiteCommand}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Padding="14,8"
                                VerticalAlignment="Center" />
                    </Grid>

                    <!-- ═══════════════ Job sites list -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Настроенные сайты"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,14" />

                            <!-- Empty state -->
                            <TextBlock Text="Нет добавленных сайтов. Нажмите «+ Добавить сайт» чтобы начать."
                                       Foreground="#9E9E9E"
                                       FontSize="13"
                                       Margin="0,8,0,8"
                                       Visibility="{Binding JobSites.Count,
                                           Converter={StaticResource InverseBoolToVis}}" />

                            <ItemsControl ItemsSource="{Binding JobSites}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:JobSiteItem}">
                                        <Border BorderBrush="#E0E0E0"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="14,10"
                                                Margin="0,0,0,8"
                                                Background="White">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon -->
                                                <Border Grid.Column="0"
                                                        Width="36"
                                                        Height="36"
                                                        Background="#E3F2FD"
                                                        CornerRadius="6"
                                                        Margin="0,0,12,0">
                                                    <TextBlock Text="🌐"
                                                               FontSize="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Name + query -->
                                                <StackPanel Grid.Column="1"
                                                            VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14"
                                                                   Margin="0,0,8,0" />
                                                        <!-- Active badge -->
                                                        <Border CornerRadius="4"
                                                                Padding="6,2"
                                                                Margin="0,0,0,1"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsActive,
                                                                    Converter={StaticResource BoolToVis}}">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="#E8F5E9" />
                                                            </Border.Background>
                                                            <TextBlock Text="активен"
                                                                       FontSize="11"
                                                                       Foreground="#388E3C" />
                                                        </Border>
                                                        <!-- Inactive badge -->
                                                        <Border CornerRadius="4"
                                                                Padding="6,2"
                                                                Margin="0,0,0,1"
                                                                VerticalAlignment="Center"
                                                                Visibility="{Binding IsActive,
                                                                    Converter={StaticResource InverseBoolToVis}}">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="#F5F5F5" />
                                                            </Border.Background>
                                                            <TextBlock Text="отключён"
                                                                       FontSize="11"
                                                                       Foreground="#9E9E9E" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock FontSize="12"
                                                               Foreground="#757575"
                                                               Margin="0,3,0,0">
                                                        <Run Text="{Binding BaseUrl}" />
                                                        <Run Text="·" />
                                                        <Run Text="«" /><Run Text="{Binding SearchQuery}" /><Run Text="»" />
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Buttons: toggle, edit, delete -->
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Button Command="{Binding DataContext.ToggleActiveCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource OutlineButtonStyle}"
                                                            Padding="8,6"
                                                            Margin="0,0,6,0"
                                                            ToolTip="Включить / отключить">
                                                        <TextBlock FontSize="13">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="⏸" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}"
                                                                                     Value="False">
                                                                            <Setter Property="Text" Value="▶" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                    <Button Content="✏"
                                                            Command="{Binding DataContext.EditSiteCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource OutlineButtonStyle}"
                                                            Padding="8,6"
                                                            Margin="0,0,6,0"
                                                            ToolTip="Редактировать" />
                                                    <Button Content="🗑"
                                                            Command="{Binding DataContext.DeleteSiteCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource OutlineButtonStyle}"
                                                            Padding="8,6"
                                                            Foreground="#E53935"
                                                            ToolTip="Удалить" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Loading indicator -->
                            <TextBlock Text="Загрузка..."
                                       Foreground="#757575"
                                       FontSize="12"
                                       Margin="0,8,0,0"
                                       Visibility="{Binding IsLoading,
                                           Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- ═══════════════ Edit form -->
                    <Border Style="{StaticResource CardStyle}"
                            Visibility="{Binding IsEditing,
                                Converter={StaticResource BoolToVis}}">
                        <StackPanel>

                            <!-- Form title -->
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Редактировать сайт" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditingItem.Id}"
                                                         Value="{x:Null}">
                                                <Setter Property="Text" Value="Новый сайт" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- ── Basic fields ── -->
                            <TextBlock Text="ОСНОВНОЕ"
                                       FontSize="11"
                                       Foreground="#9E9E9E"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Название"
                                               Foreground="#757575"
                                               FontSize="12"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EditingItem.Name, Mode=TwoWay,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,6" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Base URL"
                                               Foreground="#757575"
                                               FontSize="12"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EditingItem.BaseUrl, Mode=TwoWay,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,6" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Поисковый запрос"
                                               Foreground="#757575"
                                               FontSize="12"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EditingItem.SearchQuery, Mode=TwoWay,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,6" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="URL шаблон"
                                               Foreground="#757575"
                                               FontSize="12"
                                               Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EditingItem.SearchUrlTemplate, Mode=TwoWay,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Padding="8,6" />
                                    <TextBlock Text="{}{query} — поисковый запрос в querystring"
                                               Foreground="#9E9E9E"
                                               FontSize="11"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- ── CSS selectors ── -->
                            <TextBlock Text="CSS СЕЛЕКТОРЫ"
                                       FontSize="11"
                                       Foreground="#9E9E9E"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />

                            <!-- Mode switcher -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,14">
                                <RadioButton Content="Вручную"
                                             IsChecked="{Binding EditingItem.SelectorInputMode,
                                                 Converter={StaticResource EnumToBoolConverter},
                                                 ConverterParameter=Manual,
                                                 Mode=TwoWay}"
                                             Margin="0,0,16,0" />
                                <RadioButton Content="Вставить HTML"
                                             IsChecked="{Binding EditingItem.SelectorInputMode,
                                                 Converter={StaticResource EnumToBoolConverter},
                                                 ConverterParameter=Html,
                                                 Mode=TwoWay}"
                                             Margin="0,0,16,0" />
                                <RadioButton Content="По URL"
                                             IsChecked="{Binding EditingItem.SelectorInputMode,
                                                 Converter={StaticResource EnumToBoolConverter},
                                                 ConverterParameter=Url,
                                                 Mode=TwoWay}" />
                            </StackPanel>

                            <!-- Mode: Manual -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditingItem.SelectorInputMode}"
                                                         Value="Manual">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                Margin="0,0,0,12">
                                        <TextBlock Text="Контейнер вакансии"
                                                   Foreground="#757575"
                                                   FontSize="12"
                                                   Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditingItem.ContainerSelector, Mode=TwoWay,
                                                     UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 Padding="8,6" />
                                        <TextBlock Text="&lt;div&gt; одной вакансии — ссылка и описание ищутся внутри него"
                                                   Foreground="#9E9E9E"
                                                   FontSize="11"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ссылка"
                                                   Foreground="#757575"
                                                   FontSize="12"
                                                   Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditingItem.LinkSelector, Mode=TwoWay,
                                                     UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 Padding="8,6" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Компания"
                                                   Foreground="#757575"
                                                   FontSize="12"
                                                   Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditingItem.CompanySelector, Mode=TwoWay,
                                                     UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 Padding="8,6" />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Сниппет / описание"
                                                   Foreground="#757575"
                                                   FontSize="12"
                                                   Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditingItem.SnippetSelector, Mode=TwoWay,
                                                     UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 Padding="8,6" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Дата публикации"
                                                   Foreground="#757575"
                                                   FontSize="12"
                                                   Margin="0,0,0,4" />
                                        <TextBox Text="{Binding EditingItem.DateSelector, Mode=TwoWay,
                                                     UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 Padding="8,6" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Mode: Paste HTML -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditingItem.SelectorInputMode}"
                                                         Value="Html">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Foreground="#757575"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8">
                                    Откройте DevTools на странице поиска, скопируйте внешний
                                    <Run FontFamily="Consolas" Text="&lt;div&gt;" />
                                    со списком вакансий и вставьте сюда.
                                </TextBlock>
                                <TextBox Text="{Binding EditingItem.HtmlInput, Mode=TwoWay,
                                             UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         MinHeight="120"
                                         MaxHeight="200"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Padding="8,6"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,0,0,10" />
                                <Button Content="Найти селекторы"
                                        Command="{Binding DetectFromHtmlCommand}"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Padding="14,8"
                                        HorizontalAlignment="Right" />
                            </StackPanel>

                            <!-- Mode: By URL -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditingItem.SelectorInputMode}"
                                                         Value="Url">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Foreground="#757575"
                                           FontSize="12"
                                           Margin="0,0,0,8"
                                           TextWrapping="Wrap">
                                    Введите URL страницы с результатами поиска — приложение загрузит HTML
                                    и Claude найдёт селекторы автоматически.
                                </TextBlock>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding EditingItem.DetectUrl, Mode=TwoWay,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Padding="8,6" />
                                    <Button Grid.Column="2"
                                            Content="Анализировать"
                                            Command="{Binding DetectFromUrlCommand}"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            Padding="14,8" />
                                </Grid>
                                <TextBlock Text="Запрос выполняется из приложения, не из браузера."
                                           Foreground="#9E9E9E"
                                           FontSize="11"
                                           Margin="0,0,0,4" />
                            </StackPanel>

                            <!-- ── Claude detected selectors ── -->
                            <Border Margin="0,16,0,0"
                                    BorderBrush="#1565C0"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,12"
                                    Background="#F3F7FF"
                                    Visibility="{Binding DetectedConfig,
                                        Converter={StaticResource NullToVis}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Claude предлагает селекторы"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#1565C0"
                                                   VerticalAlignment="Center" />
                                        <Button Content="Принять все"
                                                Command="{Binding ApplyDetectedConfigCommand}"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                Padding="12,6"
                                                HorizontalAlignment="Right" />
                                    </Grid>

                                    <!-- ContainerSelector -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Контейнер"
                                                   Foreground="#757575" FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DetectedConfig.ContainerSelector}"
                                                   FontFamily="Consolas" FontSize="12"
                                                   Foreground="#212121" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Принять"
                                                Command="{Binding ApplySingleSelectorCommand}"
                                                CommandParameter="ContainerSelector"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                Padding="10,4" FontSize="12" />
                                    </Grid>

                                    <!-- LinkSelector -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Ссылка"
                                                   Foreground="#757575" FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DetectedConfig.LinkSelector}"
                                                   FontFamily="Consolas" FontSize="12"
                                                   Foreground="#212121" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Принять"
                                                Command="{Binding ApplySingleSelectorCommand}"
                                                CommandParameter="LinkSelector"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                Padding="10,4" FontSize="12" />
                                    </Grid>

                                    <!-- CompanySelector -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Компания"
                                                   Foreground="#757575" FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DetectedConfig.CompanySelector}"
                                                   FontFamily="Consolas" FontSize="12"
                                                   Foreground="#212121" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Принять"
                                                Command="{Binding ApplySingleSelectorCommand}"
                                                CommandParameter="CompanySelector"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                Padding="10,4" FontSize="12" />
                                    </Grid>

                                    <!-- SnippetSelector -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Сниппет"
                                                   Foreground="#757575" FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DetectedConfig.SnippetSelector}"
                                                   FontFamily="Consolas" FontSize="12"
                                                   Foreground="#212121" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Принять"
                                                Command="{Binding ApplySingleSelectorCommand}"
                                                CommandParameter="SnippetSelector"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                Padding="10,4" FontSize="12" />
                                    </Grid>

                                    <!-- DateSelector -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Дата"
                                                   Foreground="#757575" FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DetectedConfig.DateSelector}"
                                                   FontFamily="Consolas" FontSize="12"
                                                   Foreground="#212121" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Content="Принять"
                                                Command="{Binding ApplySingleSelectorCommand}"
                                                CommandParameter="DateSelector"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                Padding="10,4" FontSize="12" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ── Test configuration ── -->
                            <Border BorderBrush="#E0E0E0"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,10"
                                    Margin="0,20,0,0"
                                    Background="#FAFAFA">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Тест конфигурации"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                        <TextBlock Text="Скрейпит первую страницу и показывает найденные ссылки"
                                                   Foreground="#757575"
                                                   FontSize="12"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Content="▶  Протестировать"
                                            Command="{Binding ValidateConfigCommand}"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            Padding="14,8"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- ── Form buttons ── -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,20,0,0">
                                <Button Content="Отмена"
                                        Command="{Binding CancelEditCommand}"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Padding="22,10"
                                        Margin="0,0,12,0" />
                                <Button Content="Сохранить"
                                        Command="{Binding SaveSiteCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="22,10" />
                            </StackPanel>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Validation popup — overlays entire view -->
        <views:ValidationPopupView
            Visibility="{Binding IsValidationPopupOpen,
