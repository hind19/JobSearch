<UserControl x:Class="JobSearch.WPF.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             FontSize="13">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="FormFieldStyle" TargetType="TextBox">
            <Setter Property="Padding"          Value="10,8"/>
            <Setter Property="BorderBrush"      Value="#E0E0E0"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Background"       Value="White"/>
            <Setter Property="Foreground"       Value="#212121"/>
        </Style>

        <Style x:Key="FormPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#212121"/>
            <Setter Property="BorderBrush"     Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="10,8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#616161"/>
            <Setter Property="Margin"      Value="0,16,0,6"/>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
    </UserControl.InputBindings>

    <Border Background="#F2F2F2">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Background="White"
                    CornerRadius="8"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Padding="36,32"
                    Width="400">
                <StackPanel>

                    <!-- Title -->
                    <TextBlock Text="{Binding FormTitle}"
                               FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28"/>

                    <!-- Email -->
                    <TextBlock Text="{DynamicResource Login_Email}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormFieldStyle}"/>

                    <!-- Password -->
                    <TextBlock Text="{DynamicResource Login_Password}" Style="{StaticResource FieldLabelStyle}"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource FormPasswordStyle}"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <!-- Confirm Password — shown only for new users -->
                    <StackPanel Visibility="{Binding IsNewUser, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{DynamicResource Login_ConfirmPassword}" Style="{StaticResource FieldLabelStyle}"/>
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     Style="{StaticResource FormPasswordStyle}"
                                     PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                    </StackPanel>

                    <!-- Error message -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#D32F2F"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

                    <!-- Buttons -->
                    <Grid Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="{Binding NewUserButtonText}"
                                Command="{Binding ToggleNewUserCommand}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Padding="14,8"/>

                        <Button Grid.Column="2"
                                Content="{DynamicResource Common_Cancel}"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Padding="14,8"/>

                        <Button Grid.Column="4"
                                Content="{Binding LoginButtonText}"
                                Command="{Binding LoginCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="22,8"/>
                    </Grid>

                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
