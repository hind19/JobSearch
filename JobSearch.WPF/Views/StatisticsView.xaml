<UserControl x:Class="JobSearch.WPF.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:JobSearch.WPF.Converters"
             FontFamily="Segoe UI"
             FontSize="13">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Border Background="#F2F2F2">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="900"
                        Margin="32,28,32,32">

                <!-- ═══════════════ Header -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="← Назад"
                            Command="{Binding GoHomeCommand}"
                            Style="{StaticResource OutlineButtonStyle}"
                            Padding="10,8"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="Статистика"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Источники вакансий и отклонённые вакансии"
                                   Foreground="#757575"
                                   FontSize="12"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <!-- ═══════════════ Tabs -->
                <TabControl Background="Transparent"
                            BorderThickness="0">

                    <!-- ─────────── Tab 1: по сайтам (существующее содержимое) -->
                    <TabItem Header="По источникам">
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,12,0,0">
                            <StackPanel>

                                <TextBlock Text="Нет данных — Worker ещё ни разу не запускался"
                                           Foreground="#9E9E9E"
                                           FontSize="13"
                                           Margin="0,10,0,10"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                                <DataGrid ItemsSource="{Binding Rows}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column"
                                          Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Сайт"
                                                             Binding="{Binding JobSiteName}"
                                                             Width="*" />
                                        <DataGridTextColumn Header="Найдено вакансий"
                                                             Binding="{Binding JobsScrapedCount}"
                                                             Width="130" />
                                        <DataGridTextColumn Header="Совпадений"
                                                             Binding="{Binding MatchesCount}"
                                                             Width="110" />
                                        <DataGridTextColumn Header="Конверсия"
                                                             Binding="{Binding MatchRateDisplay}"
                                                             Width="100" />
                                        <DataGridTextColumn Header="Ср. релевантность"
                                                             Binding="{Binding AverageScoreDisplay}"
                                                             Width="140" />
                                        <DataGridTextColumn Header="Последнее совпадение"
                                                             Binding="{Binding MostRecentMatchDisplay}"
                                                             Width="160" />
                                    </DataGrid.Columns>
                                </DataGrid>

                            </StackPanel>
                        </Border>
                    </TabItem>

                    <!-- ─────────── Tab 2: отклонённые вакансии (ADR-0009) -->
                    <TabItem Header="Отклонённые">
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,12,0,0">
                            <StackPanel>

                                <!-- Фильтр по дате -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Дата анализа:"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />

                                    <DatePicker Grid.Column="1"
                                                SelectedDate="{Binding RejectedFilterDate, Mode=TwoWay}"
                                                Width="150"
                                                VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Text="Нет отклонённых вакансий за выбранную дату"
                                           Foreground="#9E9E9E"
                                           FontSize="13"
                                           Margin="0,10,0,10"
                                           Visibility="{Binding IsRejectedEmpty, Converter={StaticResource BoolToVis}}" />

                                <DataGrid ItemsSource="{Binding RejectedRows}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column"
                                          Visibility="{Binding IsRejectedEmpty, Converter={StaticResource InverseBoolToVis}}">
                                    <DataGrid.Columns>

                                        <!-- Кликабельная ссылка, открывает вакансию в браузере по умолчанию -->
                                        <DataGridTemplateColumn Header="Ссылка"
                                                                 Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock VerticalAlignment="Center"
                                                               ToolTip="{Binding JobTitle}">
                                                        <Hyperlink Command="{Binding DataContext.OpenJobUrlCommand,
                                                                   RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                   CommandParameter="{Binding JobUrl}">
                                                            <TextBlock Text="{Binding JobTitle}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Hyperlink>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Причина отклонения"
                                                             Binding="{Binding RelevanceReasonDisplay}"
                                                             Width="2*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Дата анализа"
                                                             Binding="{Binding AnalyzedAtDisplay}"
                                                             Width="150" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Пагинация: 20 элементов на страницу (ADR-0009) -->
                                <Grid Margin="0,14,0,0"
                                      Visibility="{Binding IsRejectedEmpty, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="← Пред."
                                            Command="{Binding RejectedPreviousPageCommand}"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            Padding="10,6"
                                            Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0">
                                        <Run Text="Стр. " />
                                        <Run Text="{Binding RejectedCurrentPage, Mode=OneWay}" />
                                        <Run Text=" из " />
                                        <Run Text="{Binding RejectedTotalPages, Mode=OneWay}" />
                                    </TextBlock>

                                    <Button Grid.Column="2"
                                            Content="След. →"
                                            Command="{Binding RejectedNextPageCommand}"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            Padding="10,6" />
                                </Grid>

                            </StackPanel>
                        </Border>
                    </TabItem>

                </TabControl>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
