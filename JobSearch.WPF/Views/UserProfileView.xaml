<UserControl x:Class="JobSearch.WPF.Views.UserProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JobSearch.WPF.ViewModels"
             xmlns:enums="clr-namespace:JobSearch.Application.Abstractions.Enums;assembly=JobSearch.Application.Abstractions"
             xmlns:conv="clr-namespace:JobSearch.WPF.Converters"
             FontFamily="Segoe UI"
             FontSize="13">

    <UserControl.Resources>

        <conv:ProficiencyLevelConverter x:Key="ProficiencyLevelConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ── PDF document icon ── -->
        <BitmapImage x:Key="PdfIconResource" UriSource="pack://application:,,,/Resources/pdf_icon.png" />

        <!-- ── Clarifying question answer templates ── -->
        <DataTemplate x:Key="SingleSelectTemplate">
            <ComboBox ItemsSource="{Binding Options}"
                      SelectedItem="{Binding SelectedAnswer, Mode=TwoWay}"
                      Width="260" HorizontalAlignment="Left"
                      Padding="8,6" Margin="0,10,0,0"/>
        </DataTemplate>

        <DataTemplate x:Key="MultipleChoiceTemplate">
            <ListBox ItemsSource="{Binding Options}"
                     SelectedItem="{Binding SelectedAnswer, Mode=TwoWay}"
                     Style="{StaticResource RadioGroupListStyle}"
                     Margin="0,10,0,0"/>
        </DataTemplate>

        <DataTemplate x:Key="NumericRangeTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="от" VerticalAlignment="Center" Foreground="#757575" Margin="0,0,8,0"/>
                <TextBox Text="{Binding RangeFrom, Mode=TwoWay, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"
                         Width="90" Padding="8,6" VerticalContentAlignment="Center"/>
                <TextBlock Text="—" VerticalAlignment="Center" Foreground="#757575" Margin="8,0"/>
                <TextBlock Text="до" VerticalAlignment="Center" Foreground="#757575" Margin="0,0,8,0"/>
                <TextBox Text="{Binding RangeTo, Mode=TwoWay, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"
                         Width="90" Padding="8,6" VerticalContentAlignment="Center"/>
                <ComboBox ItemsSource="{Binding Currencies}"
                          SelectedItem="{Binding SelectedCurrency, Mode=TwoWay}"
                          Width="75" Padding="6,6" Margin="12,0,0,0"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TextAnswerTemplate">
            <TextBox Text="{Binding TextAnswer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6" Margin="0,10,0,0"/>
        </DataTemplate>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════ Page root -->
    <Border Background="#F2F2F2">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="860" Margin="32,28,32,32">

                <!-- ═══════════════ Resume section -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Резюме" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <Border BorderBrush="#DADADA" BorderThickness="1" CornerRadius="6" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- PDF icon placeholder -->
                                <Border Grid.Column="0"
                                        Width="48" Height="48"
                                        Background="#E3F2FD" CornerRadius="6"
                                        Margin="0,0,16,0">
                                    <Image Source="{Binding CvIcon, TargetNullValue={StaticResource PdfIconResource}}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- File name + metadata -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CvFileName, FallbackValue='Файл не выбран'}"
                                               FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding CvFileInfo}"
                                               Foreground="#757575" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Action buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="⬆  Открыть"
                                            Command="{Binding ReplaceCvCommand}"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            Padding="14,8" Margin="0,0,10,0"/>
                                    <Button Content="▶  Анализировать"
                                            Command="{Binding AnalyzeCvCommand}"
                                            Style="{StaticResource OutlineButtonStyle}"
                                            Padding="14,8"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Выполняется анализ CV..."
                                   Foreground="#D32F2F"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,0"
                                   Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════════ Skills section -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>

                        <!-- Header row with legend -->
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Навыки" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Background="#E3F2FD" CornerRadius="4" Padding="7,2">
                                    <TextBlock Text="из CV" FontSize="11" Foreground="#1565C0" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text=" / " Foreground="#BDBDBD" VerticalAlignment="Center"/>
                                <Border Background="#FFF3E0" CornerRadius="4" Padding="7,2">
                                    <TextBlock Text="добавлено вручную" FontSize="11" Foreground="#BF360C" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <DataGrid ItemsSource="{Binding Skills, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F0F0"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeRows="False"
                                  CanUserSortColumns="False"
                                  SelectionUnit="Cell"
                                  SelectionMode="Single"
                                  AlternationCount="2"
                                  Background="White"
                                  BorderThickness="0"
                                  RowHeaderWidth="0"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                  CellStyle="{StaticResource GridCellStyle}"
                                  RowStyle="{StaticResource GridRowStyle}"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>

                                <!-- Source badge -->
                                <DataGridTemplateColumn Header="Источник" Width="108" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="7,2"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Margin="6,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E3F2FD"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFromCv}" Value="False">
                                                                <Setter Property="Background" Value="#FFF3E0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding SourceLabel}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1565C0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFromCv}" Value="False">
                                                                    <Setter Property="Foreground" Value="#BF360C"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Skill name — always-editable TextBox -->
                                <DataGridTemplateColumn Header="Навык" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding SkillName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalAlignment="Center" Margin="4,3"
                                                     Padding="6,4" BorderBrush="#E0E0E0" BorderThickness="1"
                                                     VerticalContentAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Proficiency level ComboBox -->
                                <DataGridTemplateColumn Header="Уровень" Width="168">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding ProficiencyLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ItemsSource="{Binding DataContext.ProficiencyLevels,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      VerticalAlignment="Center" Margin="4,3" Padding="6,4">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource ProficiencyLevelConverter}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Years of experience -->
                                <DataGridTemplateColumn Header="Опыт, лет" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding YearsOfExperience, Mode=TwoWay,
                                                         UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                     TextAlignment="Center"
                                                     VerticalAlignment="Center" Margin="4,3"
                                                     Padding="6,4" BorderBrush="#E0E0E0" BorderThickness="1"
                                                     VerticalContentAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Delete button -->
                                <DataGridTemplateColumn Width="44" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemoveSkillCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Cursor="Hand" ToolTip="Удалить">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background"      Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Foreground"      Value="#BDBDBD"/>
                                                        <Setter Property="FontSize"        Value="15"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <TextBlock Text="🗑"
                                                                               Foreground="{TemplateBinding Foreground}"
                                                                               FontSize="{TemplateBinding FontSize}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Foreground" Value="#E53935"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Content="+ Добавить навык"
                                Command="{Binding AddSkillCommand}"
                                Style="{StaticResource OutlineButtonStyle}"
                                Padding="14,8" Margin="0,14,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- ═══════════════ Clarifying questions section -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Уточняющие вопросы" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <ItemsControl ItemsSource="{Binding ClarifyingQuestions, Mode=TwoWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Decorator icon -->
                                        <TextBlock Grid.Column="0"
                                                   Text="⇄"
                                                   FontSize="14" Foreground="#B0BEC5"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Top"
                                                   Margin="0,12,0,0"/>

                                        <!-- Question card -->
                                        <Border Grid.Column="1"
                                                Background="#F7F7F7" CornerRadius="6"
                                                Padding="16,14">
                                            <StackPanel>
                                                <TextBlock Text="{Binding QuestionText}"
                                                           TextWrapping="Wrap"
                                                           FontSize="13.5" LineHeight="20"/>

                                                <!-- Input control — switches on AnswerType -->
                                                <ContentControl Content="{Binding}">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl">
                                                            <Setter Property="ContentTemplate" Value="{StaticResource TextAnswerTemplate}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AnswerType}"
                                                                             Value="{x:Static enums:AnswerType.SingleSelect}">
                                                                    <Setter Property="ContentTemplate" Value="{StaticResource SingleSelectTemplate}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding AnswerType}"
                                                                             Value="{x:Static enums:AnswerType.MultipleChoice}">
                                                                    <Setter Property="ContentTemplate" Value="{StaticResource MultipleChoiceTemplate}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding AnswerType}"
                                                                             Value="{x:Static enums:AnswerType.NumericRange}">
                                                                    <Setter Property="ContentTemplate" Value="{StaticResource NumericRangeTemplate}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══════════════ Action buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button Content="Отмена"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource OutlineButtonStyle}"
                            Padding="22,10" Margin="0,0,12,0"/>
                    <Button Content="✓  Сохранить профиль"
                            Command="{Binding SaveProfileCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="22,10"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
