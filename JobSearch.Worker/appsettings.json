{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=%ProgramData%\\JobSearch\\Database\\jobsearch.db"
  },

  "AnthropicSettings": {
    "MaxTokens": 2000,
    "RelevanceThreshold": 65,
    "Models": {
      "JobSearchAgent": "claude-opus-4-8"
    }

  },

  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "UseSsl": true,
    "FromAddress": "",
    "FromDisplayName": "JobSearch"
  },

  "WorkerSettings": {
    "ScheduleTime": "08:00",
    "DelayBetweenRequestsMs": 1500,
    "MaxPagesPerSite": 10,
    "MaxAgentToolCalls": 450
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "JobSearch": "Debug"
    }
  }
}
